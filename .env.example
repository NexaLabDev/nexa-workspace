# ============================================
# Nexa Workspace — variáveis de ambiente (EXEMPLO)
# ============================================
# Copie para .env.local e preencha. O .env.local nunca vai para o Git.
# Nunca coloque valores reais neste arquivo de exemplo.

# --- App (domínio público para clientes / e-mails de auth) ---
# Em produção use o alias sem SSO Vercel. Em local, pode omitir (cai em localhost).
NEXT_PUBLIC_APP_URL=https://nexa-workspace-tau.vercel.app

# --- Supabase (chaves novas) — Project Settings → API Keys ---
# Endereço do projeto (pode ir ao navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave PUBLICÁVEL (sb_publishable_...): pode ir ao navegador; o acesso é limitado pelas regras do banco (RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave SECRETA (sb_secret_...): SÓ NO SERVIDOR. Hoje só é usada por /api/supabase/status (localhost).
# Não é necessária na Vercel enquanto o status admin local for o único consumidor.
# SUPABASE_SECRET_KEY=sb_secret_...

# --- Notificações push (opcional; funcionalidade ainda incompleta nesta versão) ---
# Não configure na Vercel até existir agendador/produção de push.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:[A DEFINIR]

# --- Acesso ---
# O acesso é por login (Supabase Auth) e perfis no banco. Não há mais senha única de testes.
# Na Vercel (Production e Preview): NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# e NEXT_PUBLIC_APP_URL. Sem as do Supabase o site responde "configuração ausente".
