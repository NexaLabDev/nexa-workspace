# ============================================
# Nexa Workspace — variáveis de ambiente (EXEMPLO)
# ============================================
# Copie para .env.local e preencha. O .env.local nunca vai para o Git.
# Nunca coloque valores reais neste arquivo de exemplo.

# --- Supabase (chaves novas) — Project Settings → API Keys ---
# Endereço do projeto (pode ir ao navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave PUBLICÁVEL (sb_publishable_...): pode ir ao navegador; o acesso é limitado pelas regras do banco (RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave SECRETA (sb_secret_...): SÓ NO SERVIDOR. Nunca usar com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Notificações push (gere com: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do responsável pelo envio (mailto: ou https:)
VAPID_SUBJECT=mailto:[A DEFINIR]

# --- Acesso ---
# O acesso é por login (Supabase Auth) e perfis no banco. Não há mais senha única de testes.
# Na Vercel, cadastre NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# em Production e Preview. Sem elas o site responde "configuração ausente" e não abre.
